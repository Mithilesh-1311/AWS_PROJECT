EOG_DATASET_PATH=./Dataset_Isotropic/Dataset_Isotropic
EOG_SITE=http://localhost:8080
EOG_ALLOWED_ORIGINS=http://localhost:8080
EOG_USER=researcher
# Generate with: docker run --rm caddy:2.10.2-alpine caddy hash-password
# Single-quote bcrypt values so Compose preserves dollar signs.
EOG_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
EOG_PROXY_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
